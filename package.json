{
  "name": "integrationops-ai-workspace",
  "private": true,
  "description": "Root convenience scripts; the backend lives in backend/ and the frontend in frontend/",
  "scripts": {
    "start": "npm --prefix backend start",
    "test": "npm --prefix backend test -- --run",
    "typecheck": "npm --prefix backend run typecheck",
    "dev:frontend": "npm --prefix frontend run dev",
    "test:frontend": "npm --prefix frontend test",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "build:frontend": "npm --prefix frontend run build"
  }
}
